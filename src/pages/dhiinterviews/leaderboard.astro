---
import Guard from "../../components/Guard.astro";
import { PRIZE_TITLE } from "../../lib/prize";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b0c18">
<title>DhiRise · Leaderboard</title>
<link rel="icon" href="assets/dhirise-logo.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Mukta:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="css/card.css">
<link rel="stylesheet" href="css/leaderboard.css">
<link rel="stylesheet" href="css/avatar.css">
<Guard mode="protected" />
</head>
<body>
<div id="dhiBoot" hidden></div>
<!-- Founding Circle leaderboard: filled by js/leaderboard.js; data only via js/api.js -->
<header class="lb-top">
  <a class="lb-back" href="report-student.html" aria-label="Back to your report">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </a>
  <h1>Leaderboard</h1>
  <span class="lb-chip" id="lbChip" role="timer" aria-live="off"></span>
</header>

<main class="lb" id="lb">
  <p class="lb-closed" id="lbClosed" hidden>Challenge ended · Winner will be announced soon</p>

  <section class="lb-prize" aria-label="Prize">
    <img id="lbPrize" alt="" width="48" height="48">
    <p>Top referrer wins a {PRIZE_TITLE.charAt(0).toLowerCase() + PRIZE_TITLE.slice(1)}</p>
  </section>

  <section class="lb-podium" id="lbPodium" aria-label="Top 3"></section>
  <p class="lb-empty" id="lbEmpty" hidden>No one is on the board yet. The first friend to finish counts.</p>

  <ol class="lb-list" id="lbList" start="4" aria-label="Ranks 4 to 50"></ol>

  <p class="lb-foot" id="lbFoot">Updated every 5 minutes · Only completed checks with feedback count.</p>
</main>

<!-- sticky: your card, or "Join the challenge →" -->
<aside class="lb-you" id="lbYou" hidden aria-label="Your place"></aside>

<script is:inline type="text/dhi-deferred" src="js/funnel-config.js"></script>
<script is:inline type="text/dhi-deferred" src="js/challenge-config.js"></script>
<script is:inline type="text/dhi-deferred" src="js/api.js"></script>
<script is:inline type="text/dhi-deferred" src="js/share-icons.js"></script>
<script is:inline type="text/dhi-deferred" src="js/avatar.js"></script>
<script is:inline type="text/dhi-deferred" src="js/leaderboard.js"></script>
</body>
</html>
