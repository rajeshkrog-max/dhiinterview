---
import Guard from "../../components/Guard.astro";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#14110e">
<title>DhiRise · Your report</title>
<link rel="icon" href="assets/dhirise-logo.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Playfair+Display:wght@600;700&family=Mukta:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="css/report-student.css">
<link rel="stylesheet" href="css/card.css">
<link rel="stylesheet" href="css/challenge.css">
<link rel="preload" as="image" href="assets/cards/card-back.webp">
<Guard mode="protected" />
</head>
<body>
<div id="dhiBoot" hidden></div>
<!-- filled by js/report-student.js from score() and js/engine/reportText.js -->
<main class="report" id="report" aria-label="Your report"></main>

<script is:inline type="text/dhi-deferred" src="js/leaves.js"></script>
<script is:inline type="text/dhi-deferred" src="js/funnel-config.js"></script>
<script is:inline type="text/dhi-deferred" src="js/challenge-config.js"></script>
<script is:inline type="text/dhi-deferred" src="js/api.js"></script>
<script is:inline type="text/dhi-deferred" src="js/engine/questions.js"></script>
<script is:inline type="text/dhi-deferred" src="js/engine/score.js"></script>
<script is:inline type="text/dhi-deferred" src="js/engine/store.js"></script>
<script is:inline type="text/dhi-deferred" src="js/engine/reportText.js"></script>
<script is:inline type="text/dhi-deferred" src="js/report-student.js"></script>
<script is:inline type="text/dhi-deferred" src="js/engine/identity.js"></script>
<script is:inline type="text/dhi-deferred" src="js/card-export.js"></script>
<script is:inline type="text/dhi-deferred" src="js/card.js"></script>
<script is:inline type="text/dhi-deferred" src="js/challenge-ui.js"></script>
</body>
</html>
