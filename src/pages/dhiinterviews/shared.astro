---
// The public report page (spec 0010). A rewrite in public/_redirects serves THIS page, with status 200, for every /s/<code> address, so it
// is the same static file for any code and holds no student data: a link preview crawler learns nothing from it (AC-8). js/shared-boot.js
// reads the code from the address and draws the report, or one of three messages. It has no Guard, no sign in, no Convex client, no
// analytics, no leaves, no music, no challenge scripts and no identity.js, and it loads nothing from a third party (AC-13): its fonts are
// our own Mukta files (css/shared.css), and its headings use Mukta too until scope row 29 hosts the report's heading font.
// <base> makes every relative address below (css/, js/, assets/) resolve under /dhiinterviews/ whatever the page address is.
// The words of the banner and the messages are here, not in the script. og:url is left out on purpose, and no tag holds the code.
//
// SITE_ORIGIN: link previews need an absolute picture address. It is the production site; a preview deployment still points at it.
const SITE_ORIGIN = "https://dhirise.com";
const TITLE = "A DhiRise report shared with you";
const DESCRIPTION = "A student shared their DhiRise self check report with you. Take your own check to see your study picture.";
const PREVIEW = `${SITE_ORIGIN}/dhiinterviews/assets/share-preview.v1.png`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<base href="/dhiinterviews/">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#14110e">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>{TITLE}</title>
<meta name="description" content={DESCRIPTION}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="DhiRise">
<meta property="og:title" content={TITLE}>
<meta property="og:description" content={DESCRIPTION}>
<meta property="og:image" content={PREVIEW}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="assets/dhirise-favicon-64.png" type="image/png">
<link rel="stylesheet" href="css/report-student.css">
<link rel="stylesheet" href="css/avatar.css">
<link rel="stylesheet" href="css/shared.css">
</head>
<body class="shared" data-state="loading">
<div class="sh-wrap">
  <section class="card sh-banner" id="shBanner" hidden>
    <p class="sh-banner-text" id="shBannerText" data-named="{name} shared this DhiRise report with you." data-unnamed="A DhiRise report was shared with you."></p>
    <a class="btn-gold" href="landing.html">Take your own check</a>
  </section>

  <section class="card sh-msg" id="shGone" role="status" hidden>
    <h1>This link is off or has ended</h1>
    <p>The person who shared it may have turned it off, or it has run out. You can ask them to share their report again.</p>
    <a class="btn-gold" href="landing.html">Take your own check</a>
  </section>

  <section class="card sh-msg" id="shSlow" role="status" hidden>
    <h1>Lots of people are opening this right now</h1>
    <p>Please wait a minute, then open the link again.</p>
  </section>

  <section class="card sh-msg" id="shError" role="status" hidden>
    <h1>We could not open this report</h1>
    <p>Please check your connection and try again.</p>
    <button class="btn-gold" type="button" id="shRetry">Try again</button>
  </section>

  <noscript><section class="card sh-msg"><h1>This page needs JavaScript</h1><p>Please turn JavaScript on to read the report.</p></section></noscript>
</div>

<main class="report" id="report" aria-label="Shared report"></main>

<script is:inline src="js/funnel-config.js"></script>
<script is:inline src="js/engine/questions.js"></script>
<script is:inline src="js/engine/reportText.js"></script>
<script is:inline src="js/card-export.js"></script>
<script is:inline src="js/card-image.js"></script>
<script is:inline src="js/avatar.js"></script>
<script is:inline src="js/shared-boot.js"></script>
</body>
</html>
