---
// Sign in spike (scope row 4): proves Google sign in, the session, and a signed call to Convex.
// Not linked from anywhere and hidden from search. Remove or replace when real sign in lands on landing.html.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Sign in check</title>
<style is:global>
  body{font:16px/1.5 system-ui,sans-serif;max-width:480px;margin:40px auto;padding:0 16px;background:#16122b;color:#fff}
  button{font:inherit;padding:12px 18px;margin:6px 6px 6px 0;border-radius:10px;border:0;cursor:pointer}
  #status{margin:20px 0;padding:14px;border-radius:10px;background:rgba(255,255,255,.1);white-space:pre-wrap}
  .hide{display:none}
</style>
</head>
<body>
<h1>Sign in check</h1>
<div id="status">Checking…</div>
<div id="out" class="hide"><button id="google">Continue with Google</button><button id="test" class="hide">Test sign in (dev only)</button></div>
<div id="in" class="hide"><button id="signout">Sign out</button></div>
<script>
  import { authClient, createConvexClient } from "../../lib/auth-client";
  import { api } from "../../../convex/_generated/api";

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const status = (t: string) => { $("status").textContent = t; };
  const here = location.pathname.replace(/\.html$/, "");

  async function show() {
    const { data: session } = await authClient.getSession();
    $("out").classList.toggle("hide", !!session);
    $("in").classList.toggle("hide", !session);
    if (!session) { status("Not signed in."); return; }
    const convex = createConvexClient();
    // wait for the signed call to Convex to answer
    const me = await convex.query(api.auth.getCurrentUser, {});
    status(me ? "Signed in as " + me.email + "\n(name: " + me.name + ")\nConvex saw you as user " + me.id : "Session found, but Convex did not accept the token.");
    convex.close();
  }

  $("google").addEventListener("click", async () => {
    await authClient.signIn.social({ provider: "google", callbackURL: here });
  });
  $("signout").addEventListener("click", async () => { await authClient.signOut(); location.reload(); });

  // Fake sign in for automated tests. The server only allows it when TEST_SIGNIN_ENABLED is set (dev).
  if (new URLSearchParams(location.search).get("test") === "1") {
    $("test").classList.remove("hide");
    $("test").addEventListener("click", async () => {
      const email = "test.student@example.com", password = "test-pass-12345";
      let r = await authClient.signIn.email({ email, password });
      if (r.error) r = await authClient.signUp.email({ email, password, name: "Test Student" });
      if (r.error) status("Test sign in refused: " + (r.error.message || r.error.status)); else location.reload();
    });
  }
  show().catch((e) => status("Error: " + (e && e.message ? e.message : e)));
</script>
</body>
</html>
