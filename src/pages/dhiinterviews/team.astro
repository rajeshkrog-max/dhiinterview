---
// The team list (spec 0008), in the shared site frame (spec 0009): the students whose saved report copy is ready, newest first, with
// an Open link, and a box that finds one student by reference code. For named Google accounts only (TEAM_EMAILS). No Guard: the
// guard sends anyone without a student profile to the landing page, and a team member has none. src/lib/team.ts draws everything
// and sets every name and class as plain text. The page is never indexed or cached (public/_headers). The page marker the script
// reads is `page="list"`, written by the frame as data-page on <body>.
import Frame from "../../layouts/Frame.astro";
---
<Frame title="Team" description="The DhiRise team's list of saved student reports." noindex wide page="list">
  <link slot="head" rel="stylesheet" href="/dhiinterviews/css/team.css">
  <link slot="head" rel="stylesheet" href="/dhiinterviews/css/avatar.css">
  <div class="tt">
    <div class="tt-bar">
      <h1>DhiRise team: saved reports</h1>
      <button type="button" class="tt-btn" id="signOut" hidden>Sign out</button>
    </div>

    <p class="tt-msg" id="msg" role="status" aria-live="polite">Checking your sign in…</p>

    <section id="signInBox" hidden>
      <p class="tt-note">This page is for the DhiRise team. Please sign in with your Google account.</p>
      <button type="button" class="tt-btn main" id="signIn">Sign in with Google</button>
    </section>

    <section id="listBox" hidden>
      <form class="tt-find" id="find" autocomplete="off">
        <label for="ref">Find a student by reference code</label>
        <input id="ref" name="ref" type="text" inputmode="text" autocapitalize="off" spellcheck="false" maxlength="80" placeholder="Paste the code from column A">
        <button type="submit" class="tt-btn main" id="findBtn">Find</button>
        <button type="button" class="tt-btn" id="showAll" hidden>Show all</button>
      </form>
      <ul class="tt-rows" id="rows"></ul>
      <button type="button" class="tt-btn" id="more" hidden>Load more</button>
    </section>
  </div>

  <script is:inline src="/dhiinterviews/js/avatar.js"></script>
  <script>
    import "../../lib/team";
  </script>
</Frame>
