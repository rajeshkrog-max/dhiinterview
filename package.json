{
  "name": "dhirise",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:pages": "convex deploy --cmd-url-env-var-name PUBLIC_CONVEX_URL --cmd \"pnpm build\" && wrangler pages deploy dist --project-name dhirise --branch main",
    "preview:pages": "pnpm build && wrangler pages dev dist"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "astro": "^7.3.7",
    "better-auth": "~1.6.33",
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
