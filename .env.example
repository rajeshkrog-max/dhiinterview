# Copy to .env.local for local work. `pnpm exec convex dev` writes the CONVEX_* lines for you.
# Public values only here. Secrets go in Convex environment variables, never in this repo (spec 0001).
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
